    <optimization name="com.baidu.BaiduMap" refs="navigation_limit_app"/>
    <optimization name="cn.caocaokeji.dcdriver" refs="rr_deep_limit_app"/>
    <optimization name="cn.caocaokeji.user" refs="rr_deep_limit_app"/>
    <optimization name="com.tencent.map" refs="navigation_limit_app"/>

    <optimization name="com.zhiliaoapp.musically" refs="short_video"/>
    <optimization name="com.zhiliaoapp.musically.go" refs="short_video"/>
    <optimization name="com.amazon.avod.thirdpartyclient" refs="rr_deep_limit_app"/>
    <optimization name="com.kwai.video" refs="rr_deep_limit_app"/>
    <optimization name="com.google.android.deskclock" refs="rr_deep_limit_app"/>
    <optimization name="com.google.android.apps.maps" refs="navigation_limit_app"/>
    <optimization name="com.amazon.flex.rabbit" refs="rr_deep_limit_app"/>
    <optimization name="com.google.android.gms" refs="rr_deep_limit_app"/>
    <optimization name="com.ubercab.driver" refs="rr_deep_limit_app"/>
    <optimization name="com.ubercab" refs="rr_deep_limit_app"/>
    <optimization name="com.flashlight.bright.led.light" refs="rr_deep_limit_app"/>
    <optimization name="com.motorola.ccc.ota" refs="rr_deep_limit_app"/>
    <optimization name="com.google.android.calculator" refs="rr_deep_limit_app"/>
